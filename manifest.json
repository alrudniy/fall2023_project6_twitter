{
    "manifest_version": 3,
    "name": "CSAMstopper",
    "description": "CSAM detector",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": ["ContentScript/styles.css"],
            "js": ["ContentScript/testcontent.js", "ContentScript/forbiddenWords.js"]
        }
    ],
    "action": {
        "default_popup": "popup/popup1.html"
    },
    //"background": {
    //    "service_worker": "BackgroundScript/background.js",
    //    "type": "module"
    //}
    "permissions": [
        "storage", "webNavigation", "tabs"
    ]
}
