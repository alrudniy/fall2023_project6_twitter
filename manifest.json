{
    "manifest_version": 3,
    "name": "CSAMstopper",
    "description": "CSAM detector",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": ["ContentScript/content.js"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "js": "BackgroundScript/background.js",
        "persistent": true,
        "type": "module"
    },
    "permissions": [
        "storage", "webNavigation", "tabs"
    ]
}
