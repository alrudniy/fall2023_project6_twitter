{
    "manifest_version": 3,
    "name": "CSAMstopper",
    "description": "CSAM detector",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": ["content.js"]
        }
    ],
    "background": {
            "js": ["background.js"]
        }
   ,"action": {
        "default_popup": "popup/popup.html"
    },
    "icons": {
        "robot": "images/robot.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "storage"
    ]
}